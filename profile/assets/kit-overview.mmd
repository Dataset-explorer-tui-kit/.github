flowchart TD
    goal["YOU HAVE DATA<br/>Books, articles, records<br/>and questions about them"]
    kit["AGENT + REUSABLE KIT<br/>File readers, search,<br/>screens and export tools"]
    app["YOUR OWN EXPLORER<br/>Find and read records<br/>Save matching results"]
    goal --> kit
    kit --> app
    history["SAVE THE LESSONS<br/>Git records what changed<br/>Notes explain why"]
    better["LATER: BETTER BUILDS<br/>Compare what worked<br/>Test better agent choices"]
    kit -.-> history
    history -.-> better
    class goal input
    class kit agent
    class app output
    class history core
    class better optional
