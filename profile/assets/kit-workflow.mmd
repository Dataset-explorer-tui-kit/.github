flowchart TD
    intent["01 · YOU SET THE GOAL<br/>Local dataset + question<br/>Agree scope + location"]
    inspect["02 · AGENT INSPECTS<br/>Read skill + sample data<br/>Check source + budget"]
    fit{"03 · Choose the<br/>smallest useful solution"}
    recipe["RECIPE FIRST<br/>Map fields and search<br/>Explain choices + gaps"]
    custom["CUSTOM WORK<br/>Approved standalone app<br/>Extend only the gaps"]
    verify["04 · VERIFY THE RESULT<br/>Required tests, vet, build<br/>Real data + wide/narrow UI"]
    history["05 · RECORD THE WHY<br/>Agent-managed projects:<br/>decision + local checkpoint"]
    use["06 · HAND OFF AND USE<br/>Run command + limits<br/>Browse, search, export"]
    publish["OPTIONAL · PUBLISH<br/>Separate authorization<br/>Safe VHS demo + check CI"]
    intent --> inspect
    inspect --> fit
    fit -->|Supported| recipe
    fit -->|Capability gap| custom
    recipe --> verify
    custom --> verify
    verify -->|Pass| history
    verify -.->|Fail: fix and retry| fit
    history --> use
    use -.-> publish
    class intent input
    class inspect,fit,recipe,custom agent
    class verify,history core
    class use output
    class publish optional
